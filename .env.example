# =============================================================================
# Variáveis foram divididas entre os dois apps do monorepo.
# NÃO use mais um .env.local único na raiz.
# =============================================================================
#
# Backend (Riot, WhatsApp, API):
#   bot-backend/.env.example  →  copie para bot-backend/.env
#
# Frontend (dashboard Next.js):
#   web-frontend/.env.example  →  copie para web-frontend/.env.local
#
# Apenas uma variável no frontend:
#   NEXT_PUBLIC_API_URL=http://localhost:4000
