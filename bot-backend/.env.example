# =============================================================================
# Copie para .env (bot-backend)
# cp .env.example .env
# =============================================================================

# Riot API — https://developer.riotgames.com/
RIOT_API_KEY=sua_chave_riot_aqui
RIOT_GAME_NAME=SeuNome
RIOT_TAG_LINE=BR1
RIOT_REGION=americas
RIOT_PLATFORM=br1
RIOT_RANKED_DELAY_SECONDS=90

# WhatsApp
WHATSAPP_GROUP_ID=
WHATSAPP_COMMAND_PREFIX=!

# Servidor Express
PORT=4000
HOSTNAME=0.0.0.0

# CORS — URL do frontend Vercel (separe múltiplas origens por vírgula)
# Ex: https://seu-app.vercel.app,http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Dados persistentes (sessão WhatsApp, lastMatch.json, journey.json)
# Local: deixe vazio (usa bot-backend/data/)
# Render Docker: /app ou /app/data (ambos funcionam)
# Railway volume: /data
PERSISTENT_DATA_DIR=

# Chromium (Linux/Docker/Railway)
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
