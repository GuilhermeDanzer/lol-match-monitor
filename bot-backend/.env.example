# =============================================================================
# LoL Match Monitor — Worker SaaS
#
# Copie para `.env` (bot-backend/.env) e preencha os campos abaixo.
# Esse processo expõe uma mini-API HTTP (Express) que compartilha o singleton
# WhatsAppManager em memória com os Workers BullMQ. As 3 dependências
# obrigatórias são: Supabase (Postgres), Redis (BullMQ) e Riot API.
# =============================================================================

# --- Supabase / PostgreSQL ---------------------------------------------------
# Worker 24/7: use o POOLER em modo sessão (porta 5432), NÃO a URL direct IPv6.
#   postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres
#
# Alternativa transaction mode (porta 6543) — o client injeta ?pgbouncer=true automaticamente:
#   postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres
#
# Evite db.<ref>.supabase.co:5432 no Windows (só IPv6) — causa P1001 intermitente.
DATABASE_URL=postgresql://postgres.PROJECT_REF:CHANGEME@aws-1-us-east-2.pooler.supabase.com:5432/postgres

# Limite de conexões Prisma por processo (default 5). Ajuste se subir réplicas do worker.
# DATABASE_CONNECTION_LIMIT=5

# Debounce (ms) ao salvar keys Signal do Baileys — reduz spam no pooler na reconexão.
# WA_SESSION_DEBOUNCE_MS=400

# --- Redis / BullMQ ---------------------------------------------------------
# Use rediss:// (TLS) para Upstash / Redis Cloud / qualquer provider serverless.
# Localhost de dev: redis://127.0.0.1:6379
REDIS_URL=rediss://default:TOKEN@<endpoint>.upstash.io:6379

# (Opcional) REST API do Upstash — útil só para edge functions / frontend.
# UPSTASH_REDIS_REST_URL=https://<endpoint>.upstash.io
# UPSTASH_REDIS_REST_TOKEN=TOKEN

# --- Riot API ---------------------------------------------------------------
# https://developer.riotgames.com — chave dev expira em 24h, prod ~12 meses.
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Região regional (americas | asia | europe) para Match-V5 / Account-V1.
RIOT_REGION=americas

# Plataforma local (br1, na1, euw1, kr, ...) para League-V4 / Spectator.
RIOT_PLATFORM=br1

# --- API HTTP (compartilha processo com o Worker) ---------------------------

# Porta da mini-API Express consumida pela setup-UI (Next.js).
WORKER_HTTP_PORT=4000

# CSV de origens permitidas pelo CORS. Use "*" só em dev local.
# Em produção aponte para o domínio do frontend (ex: https://<app>.vercel.app).
CORS_ORIGINS=http://localhost:3000

# --- Tuning dos Workers (todos opcionais) -----------------------------------

# Intervalo entre ticks do CronQueue — poll da Riot API (default: 15 min).
# CRON_INTERVAL_MS=900000

# Relatório WhatsApp automático — só envia se houve partida nova (default: 6 h).
# REPORT_INTERVAL_MS=21600000

# Quantos match IDs olhar a cada tick por jogador (default: 10).
# RIOT_SCAN_COUNT=10

# Rate limit do RiotApiQueue — jobs por segundo (default: 20).
# Esse valor é aplicado pelo limiter nativo do BullMQ.
# RIOT_RATE_PER_SECOND=20

# Janela 2-min do dev key Riot (default: 90 — sobra para outros consumidores).
# RIOT_RATE_PER_WINDOW=90

# Concorrência dos Workers
# RIOT_WORKER_CONCURRENCY=2
# NOTIFY_WORKER_CONCURRENCY=5

# Delay (segundos) entre fim da partida e fetch de PDL na Riot — 60–120.
# RIOT_RANKED_DELAY_SECONDS=90

# Nível do logger interno do Baileys (silent | error | warn | info | debug | trace).
# Default warn — esconde "got history notification" e keep-alive noise.
# BAILEYS_LOG_LEVEL=warn

# Desliga o filtro de ruído (decrypt errors, history sync, init queries timeout).
# Use só para investigação profunda — em operação normal deixe comentado.
# BAILEYS_VERBOSE=true

# --- Comandos do bot --------------------------------------------------------

# Prefixo usado para detectar comandos em grupos (default "!").
# Ex: COMMAND_PREFIX=/  → comandos viram /status, /jornada, /ajuda
# COMMAND_PREFIX=!
