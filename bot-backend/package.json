{
  "name": "lol-match-monitor-worker",
  "version": "0.3.0",
  "private": true,
  "description": "Worker SaaS (BullMQ + Prisma + Baileys) — monitora partidas ranqueadas de LoL e notifica grupos WhatsApp.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "start": "node -r module-alias/register dist/index.js",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "seed": "tsx src/scripts/seed.ts",
    "groups": "tsx src/scripts/listGroups.ts",
    "sessions": "tsx src/scripts/sessions.ts",
    "lint": "eslint src --max-warnings 0"
  },
  "_moduleAliases": {
    "@": "dist"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@prisma/client": "^6.19.0",
    "@whiskeysockets/baileys": "^6.7.21",
    "axios": "^1.9.0",
    "bullmq": "^5.66.4",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "ioredis": "5.10.1",
    "module-alias": "^2.2.3",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.19",
    "@types/qrcode": "^1.5.6",
    "@types/qrcode-terminal": "^0.12.2",
    "prisma": "^6.19.0",
    "tsc-alias": "^1.8.17",
    "tsx": "^4.19.4",
    "typescript": "^5.9.3"
  }
}
